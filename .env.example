# MongoDB connection string. Leave unset to run in Demo mode
# (in-memory store, seeded lazily, resets on server restart).
# Example: mongodb://localhost:27017
# MONGODB_URI=

# Database name used when MONGODB_URI is set.
MONGODB_DB_NAME=ai_teacher_copilot

# Secret used to sign session cookies (HMAC-SHA256).
# REQUIRED in production. If unset, a demo fallback secret is used.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# AI provider selection: auto (default) | gemini | openai | mock.
# auto  -> GEMINI_API_KEY wins, else OPENAI_API_KEY, else mock.
# mock  -> always the deterministic sample-draft provider (demo honesty).
AI_PROVIDER=auto

# Optional model override for the selected provider.
# Defaults: gemini -> gemini-2.5-flash, openai -> gpt-4o-mini.
# AI_MODEL=

# Google Gemini (generativelanguage.googleapis.com v1beta).
# GEMINI_API_KEY=

# OpenAI (chat completions API).
# OPENAI_API_KEY=
